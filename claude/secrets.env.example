# Claude Code secrets — local, machine-specific, NEVER committed.
#
# ./install (install_me/setup_claude_secrets.sh) seeds a copy of this template
# at ~/.config/claude/secrets.env on a fresh node. After install, just edit
# that file and fill in your real tokens:
#   $EDITOR ~/.config/claude/secrets.env
# (Re-running ./install never overwrites an existing secrets.env.)
#
# etczsh/zshrc sources ~/.config/claude/secrets.env if it exists, so these
# vars are exported into the shell and inherited by `claude` and the npx MCP
# subprocesses. claude/settings.json references them via ${VAR} expansion.

export JIRA_PERSONAL_TOKEN="..."
export JENKINS_API_TOKEN="..."

# 1Password bridge (op CLI is installed) — preferred over pasting raw tokens:
export ATLASSIAN_API_TOKEN="$(op read 'op://Private/jira token for claude at nvidia/credential')"
